# TKJ Service Hub - Environment Configuration Example
# Copy this file to .env, then fill in the credentials.
# NEVER commit .env or expose these values in HTML/JavaScript/logs.

# Application environment: local | production
# Set "production" on the live server to require HTTPS for OTP endpoints.
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
# Public URL used for links/redirects. Use your HTTPS URL in production.
APP_URL=http://localhost/webjasa
# Set true only behind a trusted proxy that overwrites X-Forwarded-Proto.
APP_TRUST_PROXY_HEADERS=false

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Internal AI Bridge (PHP <-> Node.js chatbot)
# ============================================================
# Node.js chatbot base URL. Bind Node to 127.0.0.1 only.
AI_BRIDGE_URL=http://127.0.0.1:3001
# Shared HMAC secret. Minimum 32 characters. Server-side only.
# Use the same value in chatbot-node/.env. Never expose it to the browser.
AI_INTERNAL_SECRET=
# Short-lived internal token lifetime in seconds (30-300).
AI_INTERNAL_TOKEN_TTL=90

# Database Configuration (Optional Overrides)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tkj_service_hub

# ============================================================
# WhatsApp OTP - Fonnte (default)
# ============================================================
# Provider: fonnte | meta_cloud
WHATSAPP_PROVIDER=fonnte
# Token from Fonnte Dashboard -> Device. Keep this server-side only.
# Never put this token in HTML, JavaScript, source code, or logs.
# FONNTE_TOKEN is used first; FONNTE_API_TOKEN is kept as a legacy fallback.
FONNTE_TOKEN=
# FONNTE_API_TOKEN=

# ============================================================
# WhatsApp Admin Notifications (Fonnte)
# ============================================================
# Destination WhatsApp number for admin notifications (customer registered /
# order created). Format: 628xxxxxxxxxx. A local format (08xxxxxxxxxx) is
# normalized automatically to 62. Only this number ever receives a notification.
ADMIN_WHATSAPP_NUMBER=
# Timeout for Fonnte HTTP requests, in seconds (5-120).
FONNTE_TIMEOUT_SECONDS=15

# ============================================================
# Optional fallback: Meta WhatsApp Cloud API
# ============================================================
# Only used when WHATSAPP_PROVIDER=meta_cloud.
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v26.0
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=id
# WHATSAPP_OTP_TEMPLATE_BUTTON=false
